#!/usr/bin/env python3
# CX8ANM: radio por Internet en el X6100.
#
#   x6100-iradio country <CC> | top | air [CC] | search <texto>
#        lista de emisoras (directorio abierto radio-browser.info), una por línea:
#        nombre<TAB>url<TAB>códec<TAB>kbps<TAB>país   ("error <motivo>" si no hay red)
#   x6100-iradio atc <OACI> [palabras del nombre]
#        las emisoras de torre de un aeropuerto (para la app Vuelos), con el mismo formato
#   x6100-iradio atcfor LAT LON ALT_M VS SUELO [VUELO]
#        el control de tránsito aéreo de donde está un vuelo ("Seguir vuelo"): una línea @ con el aeropuerto
#        y la fase, y sus emisoras
#   x6100-iradio play <url>
#        audio PCM s16 mono 44100 Hz por la salida estándar (la GUI lo manda al parlante);
#        el estado en STATUS: tres líneas, estado ("connecting", "playing", "error ..."),
#        detalle ("MP3 128 kbps") y el título que manda la emisora
#
# MP3 lo decodifica mpg123; AAC, OGG/Opus y lo demás, ffmpeg. Listas .pls/.m3u: la primera dirección.
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request

STATUS = "/tmp/x6100-iradio.status"
UA = "X6100-CX8ANM/1.0"
API = ["https://de1.api.radio-browser.info", "https://de2.api.radio-browser.info",
       "https://fi1.api.radio-browser.info", "https://nl1.api.radio-browser.info"]
_ssl_ctx = None


class Fail(Exception):
    pass


# Los servidores SHOUTcast viejos contestan "ICY 200 OK" en vez de "HTTP/1.0 200 OK"
import http.client


def _read_status(self):
    line = str(self.fp.readline(65537), "iso-8859-1")
    if not line:
        raise http.client.RemoteDisconnected("la emisora no contestó")
    if line.startswith("ICY"):
        line = "HTTP/1.0" + line[3:]
    try:
        version, code, why = line.split(None, 2)
    except ValueError:
        try:
            version, code = line.split(None, 1)
            why = ""
        except ValueError:
            version, code, why = "", "", ""
    if not version.startswith("HTTP/"):
        self._close_conn()
        raise http.client.BadStatusLine(line)
    return version, int(code), why


http.client.HTTPResponse._read_status = _read_status


def ssl_context():
    """Certificados del sistema (paquete ca-certificates), estén donde estén."""
    global _ssl_ctx
    if _ssl_ctx is None:
        try:
            import ssl
        except ImportError:
            raise Fail("Python sin SSL (actualice el firmware)")
        _ssl_ctx = ssl.create_default_context()
        for ca in ("/etc/ssl/certs/ca-certificates.crt", "/etc/ssl/cert.pem"):
            if os.path.exists(ca):
                _ssl_ctx.load_verify_locations(ca)
                break
    return _ssl_ctx


def opener(url, headers=None, timeout=15):
    h = {"User-Agent": UA}
    h.update(headers or {})
    req = urllib.request.Request(url, headers=h)
    kw = {"timeout": timeout}
    if url.startswith("https:"):
        kw["context"] = ssl_context()
    return urllib.request.urlopen(req, **kw)


def reason(e):
    r = getattr(e, "reason", None) or getattr(e, "code", None) or e
    return " ".join(str(r).split())[:70]


# ---------- directorio de emisoras ----------
def api(path, params):
    q = urllib.parse.urlencode(params)
    last = None
    for base in API:
        try:
            with opener(base + path + "?" + q, timeout=12) as r:
                return json.load(r)
        except Exception as e:      # el siguiente servidor
            last = e
    raise Fail("sin conexión con el directorio (" + reason(last) + ")")


def clean(s):
    return " ".join(str(s or "").replace("\t", " ").split())


def print_list(rows):
    seen = set()
    n = 0
    for s in rows:
        url = s.get("url_resolved") or s.get("url") or ""
        name = clean(s.get("name"))
        if not url or not name or url in seen:
            continue
        if (s.get("hls") or 0) and not shutil.which("ffmpeg"):
            continue
        seen.add(url)
        print("\t".join([name[:60], url, clean(s.get("codec")).upper()[:8], str(s.get("bitrate") or ""),
                         clean(s.get("countrycode"))[:2]]))
        n += 1
    if not n:
        print("error no se encontraron emisoras")


COMMON = {"hidebroken": "true", "order": "clickcount", "reverse": "true", "limit": "100"}


def cmd_country(args):
    cc = (args[0] if args else "UY").upper()[:2]
    print_list(api("/json/stations/search", dict(COMMON, countrycode=cc)))


def cmd_top(args):
    print_list(api("/json/stations/search", dict(COMMON, limit="100")))


# Banda aérea: emisoras que retransmiten el control de tránsito aéreo (torres, aproximación),
# las del país primero. El X6100 no recibe la banda aérea de VHF (118-137 MHz) por radio.
AIR_TAGS = ["atc", "air traffic control", "liveatc", "airband", "air band", "tower", "atis"]
# Solo se aceptan emisoras que en el nombre, las etiquetas o la dirección dicen que son control de tránsito
# aéreo; "aviation" y parecidas traen muchas radios musicales y se descartan.
AIR_YES = re.compile(r"(\batc\b|liveatc|air ?traffic|\bairband\b|\bair band\b|\btower\b|\btwr\b|\bapproach\b|"
                     r"\bapp\b|\bground\b|\bgnd\b|\batis\b|\bdeparture\b|\bcenter\b|\bcentre\b|\btorre\b|"
                     r"aproximaci|tr[aá]nsito a[eé]reo|tr[aá]fico a[eé]reo|\b[kcslef][a-z]{3}[_ ](twr|app|gnd|del|ctr|atis)\b)", re.I)
AIR_NO = re.compile(r"\b(music|musica|música|pop|rock|hits?|jazz|dance|chill|lounge|news|noticias|talk|christian|"
                    r"gospel|country|oldies|classic|fm \d|radio fm)\b", re.I)


def is_atc(s):
    text = " ".join([clean(s.get("name")), clean(s.get("tags")), s.get("url_resolved") or s.get("url") or ""])
    return bool(AIR_YES.search(text)) and not AIR_NO.search(clean(s.get("name")) + " " + clean(s.get("tags")))


def cmd_air(args):
    cc = (args[0] if args else "").upper()[:2]
    rows = []
    errors = 0
    for tag in AIR_TAGS:
        try:
            rows += api("/json/stations/search", dict(COMMON, tag=tag, limit="80"))
        except Fail:
            errors += 1
            if errors == len(AIR_TAGS) and not own_atc():
                raise
    for word in ("ATC", "Tower", "Approach"):
        try:
            rows += api("/json/stations/search", dict(COMMON, name=word, limit="60"))
        except Fail:
            pass
    rows = [s for s in rows if is_atc(s)]
    rows.sort(key=lambda s: (clean(s.get("countrycode")).upper() != cc, -(s.get("clickcount") or 0)))
    print_list(own_atc() + rows)


ATC_FILE = "/mnt/iradio/atc.tsv"


def own_atc():
    """Las emisoras de banda aérea que cargó el usuario (página Radio por Internet de la web de la radio)."""
    out = []
    try:
        with open(ATC_FILE, encoding="utf-8", errors="replace") as f:
            for line in f:
                p = line.rstrip("\r\n").split("\t")
                if len(p) >= 2 and p[0] and p[1].startswith(("http://", "https://")):
                    p += [""] * (5 - len(p))
                    out.append({"name": "★ " + p[0], "url": p[1], "codec": p[2], "bitrate": p[3], "countrycode": p[4]})
    except OSError:
        pass
    return out


def atc_rows(icao, words):
    """Las emisoras de torre de un aeropuerto: las cargadas por el usuario que lo nombran, después las del directorio
    que dicen el código o el nombre"""
    icao = icao.upper()[:4]
    words = [w for w in words if len(w) >= 4]
    keys = [icao] + words
    def match(s):
        text = (clean(s.get("name")) + " " + clean(s.get("tags"))).upper()
        return any(k.upper() in text for k in keys)
    rows = [s for s in own_atc() if match(s)]
    found = []
    for q in keys:
        try:
            found += api("/json/stations/search", dict(COMMON, name=q, limit="40"))
        except Fail:
            if not rows and q == icao:
                raise
        try:
            found += api("/json/stations/search", dict(COMMON, tag=q.lower(), limit="20"))
        except Fail:
            pass
    return rows + [s for s in found if is_atc(s) and match(s)]


def cmd_atc(args):
    """Las emisoras de torre (control de tránsito aéreo) de un aeropuerto, para la app Vuelos:
    x6100-iradio atc SUMU Carrasco Montevideo  (el código OACI y palabras del nombre o la ciudad)."""
    if not args:
        raise Fail("falta el aeropuerto")
    print_list(atc_rows(args[0], args[1:]))


# ---------- seguir un vuelo: el control de tránsito aéreo de donde está ----------
AIRPORTS = os.environ.get("X6100_AIRPORTS", "/usr/share/x6100/airports.tsv")
ROUTE_CACHE = "/tmp/x6100-routes.json"
ATC_CACHE = "/tmp/x6100-atcfor.json"
ATC_CACHE_S = 1800
# Las emisoras de cada fase, por las palabras de su nombre: la primera lista va primero
PHASE_WORDS = {
    "ground": ["gnd", "ground", "del", "delivery", "twr", "tower", "torre"],
    "tower": ["twr", "tower", "torre", "gnd", "ground"],
    "approach": ["app", "approach", "aproximaci", "dep", "departure", "final", "radar"],
    "departure": ["dep", "departure", "app", "approach", "aproximaci", "radar"],
    "center": ["ctr", "center", "centre", "acc", "control", "area", "radar"],
}


def airports():
    out = []
    try:
        with open(AIRPORTS, encoding="utf-8") as f:
            for line in f:
                if line.startswith("#"):
                    continue
                p = line.rstrip("\n").split("\t")
                if len(p) >= 7:
                    out.append({"icao": p[0], "lat": float(p[1]), "lon": float(p[2]), "large": p[3] == "L",
                                "cc": p[4], "name": p[5], "city": p[6]})
    except (OSError, ValueError):
        pass
    return out


def km(lat1, lon1, lat2, lon2):
    import math
    p = math.pi / 180
    a = math.sin((lat2 - lat1) * p / 2) ** 2 + math.cos(lat1 * p) * math.cos(lat2 * p) * math.sin((lon2 - lon1) * p / 2) ** 2
    return 12742 * math.asin(min(1, math.sqrt(a)))


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_json(path, d):
    try:
        with open(path + ".tmp", "w") as f:
            json.dump(d, f)
        os.replace(path + ".tmp", path)
    except OSError:
        pass


def route(call):
    """(origen, destino) OACI del número de vuelo, de adsbdb.com (abierto); guardado por un día"""
    call = re.sub(r"[^A-Z0-9]", "", (call or "").upper())
    if len(call) < 4:
        return None, None
    cache = load_json(ROUTE_CACHE)
    c = cache.get(call)
    if c and time.time() - c.get("t", 0) < 86400:
        return c.get("o"), c.get("d")
    o = d = None
    try:
        with opener("https://api.adsbdb.com/v0/callsign/" + call, timeout=6) as r:
            fr = (json.load(r).get("response") or {}).get("flightroute") or {}
            o = (fr.get("origin") or {}).get("icao_code")
            d = (fr.get("destination") or {}).get("icao_code")
    except Exception:
        pass
    cache[call] = {"t": time.time(), "o": o, "d": d}
    if len(cache) > 300:
        cache = dict(sorted(cache.items(), key=lambda kv: -kv[1].get("t", 0))[:200])
    save_json(ROUTE_CACHE, cache)
    return o, d


def plan(lat, lon, alt, vs, ground, call):
    """Los aeropuertos a probar, en orden, con la fase de cada uno: [(aeropuerto, fase, km)]"""
    aps = airports()
    if not aps:
        raise Fail("falta la lista de aeropuertos")
    near = sorted(((km(lat, lon, a["lat"], a["lon"]), a) for a in aps), key=lambda x: x[0])
    by = {a["icao"]: a for a in aps}
    o, d = route(call)
    out = []
    def add(a, phase):
        if a and all(a["icao"] != x[0]["icao"] for x in out):
            out.append((a, phase, km(lat, lon, a["lat"], a["lon"])))
    if ground or (alt is not None and alt < 300):
        for dist, a in near[:3]:
            if dist <= 15:
                add(a, "ground" if ground else "tower")
    descending, climbing = vs is not None and vs <= -120, vs is not None and vs >= 120
    if alt is not None and alt < 1500:
        for dist, a in near[:4]:
            if dist <= 40:
                add(a, "tower")
    if alt is not None and alt < 6000:
        if descending and d in by and km(lat, lon, by[d]["lat"], by[d]["lon"]) <= 250:
            add(by[d], "approach")
        if climbing and o in by and km(lat, lon, by[o]["lat"], by[o]["lon"]) <= 150:
            add(by[o], "departure")
        for dist, a in near[:8]:
            if dist <= 120 and (a["large"] or dist <= 50):
                add(a, "departure" if climbing else "approach")
    # en crucero, o si nada cerca tiene emisora: el control de área de la zona, por el aeropuerto grande más cercano
    for dist, a in near[:12]:
        if a["large"] and dist <= 350:
            add(a, "center")
    if descending and d in by:
        add(by[d], "approach")
    return out[:5]


def rank(rows, phase):
    words = PHASE_WORDS.get(phase, [])
    def score(s):
        text = (clean(s.get("name")) + " " + clean(s.get("tags"))).lower()
        for i, w in enumerate(words):
            if re.search(r"\b" + re.escape(w), text):
                return i
        return len(words)
    return sorted(rows, key=score)


def cmd_atcfor(args):
    """El control de tránsito aéreo de donde está un vuelo, para "Seguir vuelo" de la app Vuelos y la web:
    x6100-iradio atcfor LAT LON ALT_M VS_M_MIN SUELO(0/1) [NUMERO_DE_VUELO]
    Primero una línea "@OACI<TAB>nombre<TAB>ciudad<TAB>fase<TAB>km<TAB>lat<TAB>lon" y después las emisoras, como atc.
    Prueba hasta 5 aeropuertos (la torre de donde está, la aproximación de su destino, el control de área de la
    zona) y se queda con el primero que tiene emisoras; lo encontrado se recuerda media hora"""
    if len(args) < 5:
        raise Fail("faltan datos del vuelo")
    num = lambda v: None if v in ("", "-", "null", "None") else float(v)
    lat, lon, alt, vs = float(args[0]), float(args[1]), num(args[2]), num(args[3])
    ground = args[4] == "1"
    call = args[5] if len(args) > 5 else ""
    cache = load_json(ATC_CACHE)
    now = time.time()
    tried = []
    steps = plan(lat, lon, alt, vs, ground, call)
    if not steps:
        raise Fail("el vuelo está lejos de todo aeropuerto con vuelos regulares")
    for a, phase, dist in steps:
        key = a["icao"] + " " + phase
        c = cache.get(key)
        if c and now - c.get("t", 0) < ATC_CACHE_S:
            rows = c["rows"]
        else:
            words = [w for w in re.split(r"[^\w]+", a["city"] + " " + a["name"]) if len(w) >= 5][:2]
            try:
                rows = rank(atc_rows(a["icao"], words), phase)
            except Fail:
                rows = []
            rows = [{"name": clean(s.get("name")), "url": s.get("url_resolved") or s.get("url") or "",
                     "codec": clean(s.get("codec")), "bitrate": s.get("bitrate") or "",
                     "countrycode": clean(s.get("countrycode")), "hls": s.get("hls") or 0} for s in rows]
            cache[key] = {"t": now, "rows": rows}
        tried.append(a["icao"])
        if rows:
            save_json(ATC_CACHE, cache)
            print("\t".join(["@" + a["icao"], a["name"], a["city"], phase, "%.0f" % dist,
                              "%.4f" % a["lat"], "%.4f" % a["lon"]]))
            print_list(rows)
            return
    save_json(ATC_CACHE, cache)
    print("error no hay emisoras de control para " + " ".join(tried))


def cmd_search(args):
    text = " ".join(args).strip()
    if not text:
        raise Fail("escriba un nombre")
    m = re.match(r"^(?:pa[ií]s|country)\s+([A-Za-z]{2})$", text, re.I)
    if m:
        return cmd_country([m.group(1)])
    rows = api("/json/stations/search", dict(COMMON, name=text, limit="80"))
    if len(rows) < 15:      # también por género (rock, tango, noticias...)
        rows += api("/json/stations/search", dict(COMMON, tag=text.lower(), limit="60"))
    print_list(rows)


# ---------- reproducción ----------
def status(state, detail="", title=""):
    try:
        tmp = STATUS + ".tmp"
        with open(tmp, "w") as f:
            f.write(f"{state}\n{detail}\n{title}\n")
        os.replace(tmp, STATUS)
    except OSError:
        pass


def resolve(url, depth=0):
    """Una lista (.pls, .m3u) a la primera dirección de audio; HLS queda tal cual (ffmpeg)."""
    low = url.lower().split("?")[0]
    if depth > 3 or not low.endswith((".pls", ".m3u", ".m3u8", ".asx")):
        return url, False
    with opener(url) as r:
        text = r.read(65536).decode("utf-8", "replace")
    if "#EXT-X-" in text:
        return url, True       # HLS
    for line in text.splitlines():
        line = line.strip()
        m = re.match(r"^File\d+=(.+)$", line, re.I)
        if m:
            line = m.group(1).strip()
        m = re.search(r'href="(https?://[^"]+)"', line, re.I)
        if m:
            line = m.group(1)
        if line.startswith(("http://", "https://")):
            return resolve(line, depth + 1)
    raise Fail("la lista no trae ninguna dirección")


def decoder(ctype, url, force_ffmpeg=False):
    ctype = (ctype or "").lower()
    mp3 = "mpeg" in ctype or "mp3" in ctype or (not ctype and url.lower().split("?")[0].endswith(".mp3"))
    if mp3 and shutil.which("mpg123") and not (force_ffmpeg and shutil.which("ffmpeg")):
        return ["mpg123", "-q", "-s", "-m", "-r", "44100", "-"], "MP3"
    if shutil.which("ffmpeg"):
        name = "AAC" if "aac" in ctype or "mp4" in ctype else "OGG" if "ogg" in ctype or "opus" in ctype else \
               "MP3" if mp3 else (ctype.split("/")[-1][:6].upper() or "AUDIO")
        return ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "quiet", "-i", "pipe:0",
                "-f", "s16le", "-ac", "1", "-ar", "44100", "pipe:1"], name
    if shutil.which("mpg123"):
        return ["mpg123", "-q", "-s", "-m", "-r", "44100", "-"], "MP3"
    raise Fail("formato " + (ctype or "?") + " no soportado")


def title_of(meta):
    try:
        text = meta.rstrip(b"\0").decode("utf-8")
    except UnicodeDecodeError:
        text = meta.rstrip(b"\0").decode("latin-1", "replace")
    m = re.search(r"StreamTitle='(.*?)';", text, re.S)
    return clean(m.group(1))[:90] if m else None


def play_hls(url):
    if not shutil.which("ffmpeg"):
        raise Fail("esta emisora usa HLS: falta ffmpeg")
    status("connecting", "HLS")
    p = subprocess.Popen(["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "quiet", "-i", url,
                          "-f", "s16le", "-ac", "1", "-ar", "44100", "pipe:1"], stdin=subprocess.DEVNULL)
    time.sleep(2)
    if p.poll() is None:
        status("playing", "HLS")
    rc = p.wait()
    if rc:
        raise Fail("no se pudo abrir la emisora (HLS)")


def play_once(url, force_ffmpeg=False):
    url, hls = resolve(url)
    if hls:
        return play_hls(url)
    r = opener(url, {"Icy-MetaData": "1"}, timeout=15)
    ctype = (r.headers.get("Content-Type") or "").split(";")[0].strip()
    if ctype.startswith(("text/html", "application/json")):
        raise Fail("la dirección no es una emisora (" + ctype + ")")
    if ctype in ("audio/x-scpls", "audio/x-mpegurl", "application/vnd.apple.mpegurl", "audio/mpegurl"):
        r.close()
        url, hls = resolve(url + ("" if url.lower().endswith((".pls", ".m3u", ".m3u8")) else "#.m3u"))
        if hls:
            return play_hls(url)
        r = opener(url, {"Icy-MetaData": "1"}, timeout=15)
        ctype = (r.headers.get("Content-Type") or "").split(";")[0].strip()
    metaint = int(r.headers.get("icy-metaint") or 0)
    kbps = r.headers.get("icy-br") or ""
    cmd, codec = decoder(ctype, url, force_ffmpeg)
    detail = codec + (" " + kbps.split(",")[0] + " kbps" if kbps else "")
    name = clean(r.headers.get("icy-name") or "")
    p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
    status("playing", detail, name)
    try:
        while True:
            chunk = r.read(metaint if metaint else 8192)
            if not chunk:
                raise Fail("la emisora cortó")
            p.stdin.write(chunk)
            if metaint:
                n = r.read(1)
                if not n:
                    raise Fail("la emisora cortó")
                if n[0]:
                    t = title_of(r.read(n[0] * 16))
                    if t is not None:
                        status("playing", detail, t or name)
            if p.poll() is not None:
                raise Fail("el decodificador se detuvo")
    except BrokenPipeError:
        raise Fail("el decodificador se detuvo")
    finally:
        try:
            p.stdin.close()
        except Exception:
            pass
        try:
            p.wait(timeout=5)       # que termine de sacar lo que tiene
        except subprocess.TimeoutExpired:
            p.kill()
        r.close()


def cmd_play(args):
    if not args:
        raise Fail("falta la dirección")
    url = args[0]
    tries = 0
    force_ffmpeg = False
    while True:
        status("connecting")
        started = time.time()
        try:
            play_once(url, force_ffmpeg)
            return 0
        except Fail as e:
            err = str(e)
            if "decodificador" in err:
                force_ffmpeg = True     # una emisora que dice MP3 y manda otra cosa: ffmpeg se arregla
        except Exception as e:
            err = reason(e)
        # si sonó un rato y se cortó, se reconecta (hasta 3 veces seguidas)
        tries = 0 if time.time() - started > 60 else tries + 1
        if tries >= 3:
            status("error " + err)
            return 1
        status("connecting", "reconectando: " + err)
        time.sleep(2)


def main(argv):
    cmds = {"country": cmd_country, "top": cmd_top, "search": cmd_search, "air": cmd_air, "atc": cmd_atc, "atcfor": cmd_atcfor,
            "play": cmd_play}
    if len(argv) < 2 or argv[1] not in cmds:
        print("uso: x6100-iradio country CC | top | air [CC] | atc OACI [nombre] | atcfor LAT LON ALT VS SUELO [VUELO] | search TEXTO | play URL", file=sys.stderr)
        return 2
    try:
        return cmds[argv[1]](argv[2:]) or 0
    except Fail as e:
        if argv[1] == "play":
            status("error " + str(e))
        else:
            print("error", e)
        return 1
    except Exception as e:
        if argv[1] == "play":
            status("error " + reason(e))
        else:
            print("error", reason(e))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
